#!/bin/bash

set -euo pipefail

if [[ -f /etc/debian_version ]]; then
  sudo_cmd=()
  if (( EUID != 0 )); then
    sudo_cmd=(sudo -n)
  fi

  "${sudo_cmd[@]}" apt-get update
  "${sudo_cmd[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl git zsh bash-completion build-essential autoconf m4 pkg-config \
    libncurses-dev libssl-dev unzip xz-utils
elif [[ -f /etc/arch-release ]]; then
  sudo -n pacman -S --needed --noconfirm \
    ca-certificates curl git zsh bash-completion base-devel ncurses openssl unzip xz
elif [[ "$(uname)" == Darwin ]]; then
  command -v brew >/dev/null 2>&1 || {
    echo "manual_deps: Install Homebrew before running setup" >&2
    exit 1
  }
  brew install git zsh autoconf openssl ncurses
else
  echo "manual_deps: Unsupported OS" >&2
  exit 1
fi
