export PATH="$HOME/.local/bin:${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"

[[ -o interactive ]] || return 0

export ZSH="$HOME/.oh-my-zsh"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit
fi

bindkey -v
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_SPACE HIST_IGNORE_DUPS SHARE_HISTORY

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
fi

if command -v fzf >/dev/null 2>&1 && fzfInit="$(fzf --zsh 2>/dev/null)"; then
  eval "$fzfInit"
elif [[ -r "$HOME/.fzf.zsh" ]]; then
  source "$HOME/.fzf.zsh"
fi
unset fzfInit

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v bat >/dev/null 2>&1; then
  alias cat=bat
elif command -v batcat >/dev/null 2>&1; then
  alias cat=batcat
fi

if command -v chezmoi >/dev/null 2>&1; then
  alias ch=chezmoi
fi

if [[ -d "${ANDROID_HOME:-$HOME/Android/Sdk}" ]]; then
  export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
  export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
fi

if [[ -r "$HOME/.safe-chain/scripts/init-posix.sh" && -x "$(command -v safe-chain)" ]]; then
  source "$HOME/.safe-chain/scripts/init-posix.sh"
fi
